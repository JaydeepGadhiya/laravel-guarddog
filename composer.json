{
    "name": "jaydeep/laravel-guarddog",
    "description": "Laravel GuardDog — Scan your Laravel project for common security vulnerabilities and generate beautiful HTML reports.",
    "keywords": [
        "laravel",
        "security",
        "scanner",
        "vulnerability",
        "audit",
        "guarddog",
        "security-audit",
        "security-scanner",
        "static-analysis",
        "sql-injection",
        "csrf",
        "owasp",
        "penetration-testing",
        "code-review",
        "laravel-security",
        "laravel-audit",
        "security-report",
        "php-security",
        "artisan",
        "devtools"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JaydeepGadhiya/laravel-guarddog",
    "support": {
        "issues": "https://github.com/JaydeepGadhiya/laravel-guarddog/issues",
        "source": "https://github.com/JaydeepGadhiya/laravel-guarddog"
    },
    "authors": [
        {
            "name": "Jaydeep Gadhiya",
            "email": "jaydeepgadhiya5699@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Jaydeep\\GuardDog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jaydeep\\GuardDog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jaydeep\\GuardDog\\GuardDogServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
